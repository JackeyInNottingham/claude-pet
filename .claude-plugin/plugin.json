{
  "name": "claude-pet",
  "version": "0.1.1",
  "description": "Desktop pet that shows Claude Code's running status with a cute pixel-art mascot. Reflects real-time states like reading, writing, executing, and handles permission requests through an interactive dialog.",
  "author": {
    "name": "Jiyao Fei"
  },
  "homepage": "https://github.com/JackeyInNottingham/claude-pet",
  "license": "MIT",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/notify-pet.js\" tool-start \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/notify-pet.js\" tool-finish \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/notify-pet.js\" tool-fail \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/notify-pet.js\" idle \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/notify-pet.js\" permission-notify \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/notify-pet.js\" permission-request \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.js\" \"${CLAUDE_PLUGIN_ROOT}\""
          }
        ]
      }
    ]
  },
  "commands": {
    "pet": {
      "description": "Control the Claude Pet desktop companion — start, stop, toggle, or check status",
      "source": "./commands/pet.md"
    }
  }
}
